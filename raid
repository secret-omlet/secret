-- RaidModule.lua
-- این فایل رو توی گیتهاب بزار

local RaidModule = {}

function RaidModule(Settings, WindUI, RaidConfig)
    
    local Plr = game:GetService("Players").LocalPlayer
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Workspace = game:GetService("Workspace")
    local VirtualInputManager = game:GetService("VirtualInputManager")
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    
    local Remotes = ReplicatedStorage:WaitForChild("Remotes")
    local CommF = Remotes:WaitForChild("CommF_")
    
    -- ═══════════════════════════════════════
    -- توابع داخلی رید
    -- ═══════════════════════════════════════
    local function Log(msg)
        print("[Raid Module] " .. msg)
    end

    local function FireClick()
        local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
        VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)
    end

    local function EquipWeapon()
        pcall(function()
            if not Plr.Character or not Plr.Character:FindFirstChild("Humanoid") then return end
            local h = Plr.Character.Humanoid
            local toolType = RaidConfig.WeaponMode
            if toolType == "MeleeGun" then toolType = "Melee" end
            if toolType == "MeleeAbility" then toolType = "Melee" end
            
            local currentTool = Plr.Character:FindFirstChildOfClass("Tool")
            if currentTool and string.find(currentTool.ToolTip or "", toolType) then return end
            
            for _, t in pairs(Plr.Backpack:GetChildren()) do
                if t:IsA("Tool") and string.find(t.ToolTip or "", toolType) then
                    h:EquipTool(t)
                    break
                end
            end
        end)
    end

    -- نوکلیپ (رد شدن از دیوار) مخصوص رید
    RunService.Stepped:Connect(function()
        if RaidConfig.RaidEnabled and Plr.Character then
            pcall(function()
                for _, p in pairs(Plr.Character:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
                if Plr.Character:FindFirstChild("HumanoidRootPart") then
                    Plr.Character.HumanoidRootPart.Velocity = Vector3.zero
                end
            end)
        end
    end)

    -- ═══════════════════════════════════════
    -- لوپ اصلی رید
    -- ═══════════════════════════════════════
    task.spawn(function()
        while task.wait(0.1) do
            if not RaidConfig.RaidEnabled then continue end
            if not Plr.Character or not Plr.Character:FindFirstChild("HumanoidRootPart") then continue end

            pcall(function()
                local Root = Plr.Character.HumanoidRootPart
                local InRaid = Workspace:FindFirstChild("Raids") ~= nil
                
                if not InRaid then
                    -- 1. بیرون از رید (خرید چیپ و تلپورت به داخل)
                    local Map = Workspace:FindFirstChild("Map")
                    if not Map then return end
                    
                    -- رفتن به آزمایشگاه / مکان رید
                    local button = Map:FindFirstChild("MicroTransactions") and Map.MicroTransactions:FindFirstChild("TeleportButton")
                    if button then
                        -- خرید چیپ
                        CommF:InvokeServer("RaidsNpc", "Select", RaidConfig.RaidSelectedType)
                        task.wait(0.5)
                        
                        -- فشار دادن دکمه
                        if (Root.Position - button.Position).Magnitude > 5 then
                            Root.CFrame = button.CFrame
                        else
                            firetouchinterest(Root, button, 0)
                            task.wait(0.1)
                            firetouchinterest(Root, button, 1)
                        end
                    end
                    
                    -- بیداری فروت (Awakening Room)
                    local Awakener = Workspace:FindFirstChild("AwakeningRoom") -- اسم حدودی بر اساس مپ
                    if Awakener or (Root.Position.Y > 5000 and not InRaid) then -- مکان‌های بیداری معمولا خیلی بالا هستند
                        CommF:InvokeServer("Awakener", "Check")
                        task.wait(0.5)
                        CommF:InvokeServer("Awakener", "Awaken")
                        task.wait(1)
                        if not RaidConfig.RaidAutoRestart then
                            RaidConfig.RaidEnabled = false
                            WindUI:Notify({Title="اتو رید", Content="رید با موفقیت تمام شد!", Duration=5})
                        else
                            -- تلپورت به بیرون تا دوباره شروع کنه
                            Plr.Character.Head:Destroy() -- ریست شدن سریع
                        end
                    end
                else
                    -- 2. داخل رید
                    local Enemies = Workspace.Enemies:GetChildren()
                    local RaidEnemy = nil
                    local NearestDist = math.huge
                    
                    -- پیدا کردن ماب‌های رید
                    for _, v in pairs(Enemies) do
                        if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                            local dist = (Root.Position - v.HumanoidRootPart.Position).Magnitude
                            if dist < NearestDist then
                                NearestDist = dist
                                RaidEnemy = v
                            end
                        end
                    end
                    
                    if RaidEnemy then
                        -- زدن ماب
                        local E_Root = RaidEnemy.HumanoidRootPart
                        local Dest = E_Root.CFrame * CFrame.new(0, Settings.AttackHeight, Settings.AttackDistance)
                        
                        -- تلپورت نرم (تویین)
                        if (Root.Position - Dest.Position).Magnitude > 10 then
                            Root.CFrame = Dest
                        end
                        
                        -- نگاه کردن به ماب و اتک
                        Workspace.CurrentCamera.CFrame = CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, E_Root.Position)
                        EquipWeapon()
                        
                        CommF:InvokeServer("Buso") -- روشن کردن هاکی
                        Net:WaitForChild("RE/RegisterAttack"):FireServer()
                        FireClick()
                    else
                        -- 3. رفتن به جزیره بعدی (وقتی مابی نیست)
                        local Locations = Workspace:FindFirstChild("_WorldOrigin") and Workspace._WorldOrigin:FindFirstChild("Locations")
                        if Locations then
                            local NextIsland = nil
                            local HighestNum = 0
                            
                            for _, loc in pairs(Locations:GetChildren()) do
                                if loc.Name == "Island" .. tostring(HighestNum + 1) then
                                    NextIsland = loc
                                    HighestNum = HighestNum + 1
                                end
                            end
                            
                            if NextIsland then
                                Root.CFrame = NextIsland.CFrame * CFrame.new(0, 50, 0)
                            end
                        end
                    end
                end
            end)
        end
    end)

    -- ═══════════════════════════════════════
    -- رابط اتصال به منو (API)
    -- ═══════════════════════════════════════
    local API = {}
    
    function API.Start()
        RaidConfig.RaidEnabled = true
        RaidConfig.RaidPhase = "Starting"
        Log("روشن شد! نوع رید: " .. tostring(RaidConfig.RaidSelectedType))
    end
    
    function API.Stop()
        RaidConfig.RaidEnabled = false
        RaidConfig.RaidPhase = "Idle"
        if RaidConfig.ActiveTween then 
            RaidConfig.ActiveTween:Cancel() 
            RaidConfig.ActiveTween = nil 
        end
        Log("خاموش شد.")
    end
    
    function API.SetAutoRestart(state)
        RaidConfig.RaidAutoRestart = state
    end
    
    function API.SetType(raidType)
        RaidConfig.RaidSelectedType = raidType
    end
    
    function API.SetFruit(fruitName)
        RaidConfig.RaidSelectedFruit = fruitName
    end
    
    function API.SetWeaponMode(mode)
        RaidConfig.WeaponMode = mode
    end

    return API
end

return RaidModule
