    local function WaitForOptionWithText(dialogue, keyword, timeout)
        local t = 0
        local kw = string.lower(keyword)
        while t < timeout do
            if dialogue then
                for _, child in ipairs(dialogue:GetChildren()) do
                    if child:IsA("GuiButton") and string.match(child.Name, "Option%d+") and child.Visible then
                        local textLabel = child:FindFirstChild("TextLabel") or child:FindFirstChildWhichIsA("TextLabel", true)
                        if textLabel then
                            local ok, txt = pcall(function() return textLabel.Text end)
                            if ok and txt and txt ~= "" then
                                if string.find(string.lower(txt), kw) then
                                    return child
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.2)
            t = t + 0.2
        end
        return nil
    end

