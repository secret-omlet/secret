    local function EquipWeaponGeneral()
        pcall(function()
            local h = Plr.Character:FindFirstChild("Humanoid")
            if not h then return end
            local current = Plr.Character:FindFirstChildOfClass("Tool")
            if current and (current.ToolTip == "Melee" or current.ToolTip == "Sword" or current.ToolTip == "Blox Fruit") then return end
            for _, t in pairs(Plr.Backpack:GetChildren()) do 
                if t:IsA("Tool") and (t.ToolTip == "Sword" or t.ToolTip == "Blox Fruit" or t.ToolTip == "Melee") then 
                    h:EquipTool(t); break 
                end 
            end
        end)
    end

    local function EquipToolByName(name)
        pcall(function()
            if not Plr.Character then return end
            local h = Plr.Character:FindFirstChild("Humanoid")
            if not h then return end
            for _, t in pairs(Plr.Character:GetChildren()) do if t:IsA("Tool") and t.Name == name then return end end
            for _, t in pairs(Plr.Backpack:GetChildren()) do if t:IsA("Tool") and t.Name == name then h:EquipTool(t); return end end
        end)
    end

    local function PrepareEnemyForBoss(E)
        pcall(function()
            if not E or not E.Parent or not E:FindFirstChild("HumanoidRootPart") then return end
            local H = E:FindFirstChild("Head")
            if H and not E:FindFirstChild("FakeHead") then
                local FH = H:Clone(); FH.Name = "FakeHead"; FH.CanCollide = false; FH.Massless = true; FH.Size = H.Size; FH.Transparency = H.Transparency; FH.Parent = E
                local W = Instance.new("WeldConstraint"); W.Part0 = H; W.Part1 = FH; W.Parent = FH
                H.Size = Vector3.new(Settings.HeadSize or 100, Settings.HeadSize or 100, Settings.HeadSize or 100); H.Transparency = 1; H.CanCollide = false
                for _, c in pairs(H:GetChildren()) do if c:IsA("SpecialMesh") or c:IsA("Decal") then c:Destroy() end end
            end
            local hum = E:FindFirstChild("Humanoid")
            if hum then hum.WalkSpeed = 0; hum.JumpPower = 0; if hum:FindFirstChild("Animator") then hum.Animator:Destroy() end end
            for _, p in pairs(E:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        end)
    end

