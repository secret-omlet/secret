    ExtraModule1.ToggleDragonTalon = function(s)
        if s then
            local beli = Plr.Data.Beli.Value
            local frags = Plr.Data.Fragments.Value
            if beli < 3000000 then WindUI:Notify({Title="خطا", Content="پول شما کمتر از 3 میلیون است!", Duration=5}); return end
            if frags < 5000 then WindUI:Notify({Title="خطا", Content="فرگمنت شما کمتر از 5000 است!", Duration=5}); return end
            
            local char = Plr.Character
            local meleeTool = nil
            if char then
                local t = char:FindFirstChildOfClass("Tool")
                if t and t.ToolTip == "Melee" then meleeTool = t end
            end
            if not meleeTool then
                for _, t in ipairs(Plr.Backpack:GetChildren()) do
                    if t:IsA("Tool") and t.ToolTip == "Melee" then meleeTool = t; break end
                end
            end
            if not meleeTool then WindUI:Notify({Title="خطا", Content="هیچ میلی در کیف یا دست شما نیست!", Duration=5}); return end
            local lowerName = string.lower(meleeTool.Name)
            if not (string.find(lowerName, "dragon claw") or string.find(lowerName, "dragonbreath")) then
                WindUI:Notify({Title="خطا", Content="میلی فعلی شما Dragon Breath نیست!", Duration=5}); return 
            end
            local masteryVal = meleeTool:FindFirstChild("Level")
            local mastery = masteryVal and masteryVal.Value or 0
            if mastery < 400 then
                WindUI:Notify({Title="خطا", Content="مستری Dragon Breath شما " .. tostring(mastery) .. " است (باید بالای 400 باشد)!", Duration=5}); return 
            end

            State.AutoDragonTalon = true
            WindUI:Notify({Title="دراگون تالون", Content="تایید شد! استارت خودکار فارم استخوان...", Duration=5})
            if getgenv().Extra1_StartBones then getgenv().Extra1_StartBones() end
        else
            State.AutoDragonTalon = false
        end
    end

