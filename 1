                if State.AutoBartilo and not State.BartiloIsChecking then
                    pcall(function()
                        State.BartiloIsChecking = true
                        local progress = ReplicatedStorage.Remotes.CommF_:InvokeServer("BartiloQuestProgress", "Bartilo")
                        progress = tonumber(progress)
                        if progress and (State.BartiloPhase == -1 or progress > State.BartiloPhase) then State.BartiloPhase = progress end
                        State.BartiloIsChecking = false
                    end)
                end
            end
        end)

        -- لوپ تشخیص حرکت بارتیلو
        task.spawn(function()
            while task.wait(0.1) do
                if not State.AutoBartilo or State.BartiloIsChecking then continue end
                local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                if not root then continue end

                if State.BartiloPhase == -1 then continue end

                if State.BartiloPhase == 0 then
                    if not HasQuest() then
                        State.BartiloTarget = {Mode = "Move", CFrame = BartiloQuestPos}
                        if (root.Position - BartiloQuestPos.Position).Magnitude < 15 then
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BartiloQuest", 1)
                            task.wait(1)
                            HandleDialogueQuick()
                        end
                    else
                        local fm, md = nil, math.huge
                        local E = Workspace:FindFirstChild("Enemies")
                        if E then
                            for _, v in pairs(E:GetChildren()) do
                                if string.find(v.Name, "Swan Pirate") and IsEnemyValid(v) then
                                    local d = (root.Position - v.HumanoidRootPart.Position).Magnitude
                                    if d < md then md = d; fm = v end
                                end
                            end
                        end
                        if fm then
                            PrepareEnemyForBoss(fm)
                            State.BartiloTarget = {Mode = "Mob", Instance = fm}
                        else
                            local realPos = GetRealSpawn("Swan Pirate", SwanPirateArea)
                            State.BartiloTarget = {Mode = "Wait", CFrame = realPos * CFrame.new(0, Settings.WaitHeight or 40, 0)}
                        end
                    end
                elseif State.BartiloPhase == 1 then
                    local jeremyInstance = nil
                    local E = Workspace:FindFirstChild("Enemies")
                    if E then
                        for _, v in pairs(E:GetChildren()) do
                            if string.find(v.Name, "Jeremy") and IsEnemyValid(v) then jeremyInstance = v; break end
                        end
                    end
                    if jeremyInstance then
                        PrepareEnemyForBoss(jeremyInstance)
                        State.BartiloTarget = {Mode = "Mob", Instance = jeremyInstance}
                    else
                        local realJeremyPos = GetRealSpawn("Jeremy", JeremyQuestNPC)
                        State.BartiloTarget = {Mode = "Wait", CFrame = realJeremyPos * CFrame.new(0, Settings.WaitHeight or 40, 0)}
                    end
                elseif State.BartiloPhase == 2 then
                    if not State.BartiloReachedStart then
                        State.BartiloTarget = {Mode = "Move", CFrame = BartiloStartPos}
                        if (root.Position - BartiloStartPos.Position).Magnitude < 15 then
                            task.wait(0.5)
                            State.BartiloReachedStart = true
                        end
                    else
                        if State.BartiloPlateIndex <= 8 then
                            local targetCFrame = nil
                            if State.BartiloPlateIndex == 5 then
                                targetCFrame = Plate5FixedCFrame
                            else
                                local plateFolder = Workspace:FindFirstChild("Map") 
                                    and Workspace.Map:FindFirstChild("Dressrosa") 
                                    and Workspace.Map.Dressrosa:FindFirstChild("BartiloPlates")
                                
                                if plateFolder then
                                    local targetPart = plateFolder:FindFirstChild("Plate" .. tostring(State.BartiloPlateIndex))
                                    if targetPart and targetPart:IsA("BasePart") then
                                        targetCFrame = targetPart.CFrame
                                    end
                                end
                            end
                            
                            if targetCFrame then
                                State.BartiloTarget = {Mode = "Move", CFrame = targetCFrame}
                                if (root.Position - targetCFrame.Position).Magnitude < 15 then
                                    task.wait(0.3)
                                    State.BartiloPlateIndex = State.BartiloPlateIndex + 1
                                end
                            else
                                State.BartiloTarget = {Mode = "Wait", CFrame = root.CFrame}
                            end
                        else
                            pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("BartiloQuestProgress", "DidPlates") end)
                            State.BartiloPhase = 3
                        end
                    end
                elseif State.BartiloPhase == 3 then
                    State.BartiloTarget = nil
                    if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                    State.AutoBartilo = false
                    WindUI:Notify({Title="Bartilo Quest", Content="کوئست بارتیلو با موفقیت کامل شد!", Duration=5})
                    if State.IsDoingPriorityTask then State.IsDoingPriorityTask = false; ResumeFarms() end
                end
            end
        end)

        -- لوپ حرکت پروازی بارتیلو
        task.spawn(function()
            while task.wait(0.1) do
                pcall(function()
                    if not State.AutoBartilo or not State.BartiloTarget then return end
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    
                    local dest = nil
                    if State.BartiloTarget.Mode == "Move" or State.BartiloTarget.Mode == "Wait" then
                        dest = State.BartiloTarget.CFrame
                    elseif State.BartiloTarget.Mode == "Mob" and State.BartiloTarget.Instance and State.BartiloTarget.Instance:FindFirstChild("HumanoidRootPart") then
                        local EP = State.BartiloTarget.Instance.HumanoidRootPart.Position
                        local d = (root.Position - EP); d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude < 0.1 then d = Vector3.new(1,0,0) end; d = d.Unit
                        dest = CFrame.lookAt(EP + d * (Settings.AttackDistance or 10) + Vector3.new(0, (Settings.AttackHeight or 10), 0), EP)
                    end

                    if dest then
                        local dist = (root.Position - dest.Position).Magnitude
                        if dist >= 10 then 
                            State.ActiveTween = SmartTween(root, dest, State.ActiveTween)
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                        end
                    end
                end)
            end
        end)

        -- لوپ اتک بارتیلو
        task.spawn(function()
            while true do
                local Clicked = false
                pcall(function()
                    if not State.AutoBartilo or not State.BartiloTarget or State.BartiloTarget.Mode ~= "Mob" then return end
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    
                    local E = State.BartiloTarget.Instance
                    if not IsEnemyValid(E) then return end
                    
                    if E ~= State.BartiloLastEnemy then 
                        State.BartiloLastEnemy = E
                        State.BartiloLastEnemyTime = tick() 
                    end
                    if tick() - State.BartiloLastEnemyTime < (Settings.AttackWaitTime or 2) then return end
                    
                    local EP = E:FindFirstChild("HumanoidRootPart") and E.HumanoidRootPart.Position
                    if EP then
                        local d = (root.Position - EP)
                        d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude < 0.1 then d = Vector3.new(1,0,0) end
                        local dest = EP + d.Unit * (Settings.AttackDistance or 10) + Vector3.new(0, Settings.AttackHeight or 10, 0)
                        
                        if (root.Position - dest).Magnitude < 15 then
                            EquipWeaponGeneral()
                            if E:FindFirstChild("Head") then Workspace.CurrentCamera.CFrame = CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, E.Head.Position) end
                            
                            local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
                            VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1)
                            task.wait(Settings.HoldTime or 0.01)
                            VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)
                            
                            if RegisterAttack then 
                                RegisterAttack:FireServer(math.floor((0.5 + math.random() * 0.5) * 10000) / 10000) 
                            end
                            Clicked = true
                        end
                    end
                end)
                
                if Clicked then
                    local minDelay = Settings.MinClickDelay or 0.05
                    local maxDelay = Settings.MaxClickDelay or 0.09
                    local delay = minDelay + (math.random() * (maxDelay - minDelay))
                    task.wait(delay)
                else
                    task.wait(0.15)
                end
            end
        end)
    end

    -- ========================================================
    -- سیستم‌های جدید دریای دوم (Cursed Ship, Hellfire, Ecto, Cursed Captain)
    -- ========================================================
    if Sea == 2 then
        -- چکر مداوم Ectoplasm
        task.spawn(function()
            local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
            while task.wait(2) do
                pcall(function()
                    local res = CommF:InvokeServer("Ectoplasm", "Check")
                    local num = tonumber(tostring(res)) or 0
                    State.EctoCount = num
                    getgenv().EctoCount = num
                    State.HasTorch = CheckHasTorch()
                end)
            end
        end)

        -- ۱. لوپ اصلی Hellfire Torch Auto Farmer
        task.spawn(function()
            local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
            while task.wait(0.2) do
                if not State.AutoHellfire then continue end
                local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                if not root then continue end

                if State.HellfirePhase == "Entering" then
                    WindUI:Notify({Title="Hellfire Torch", Content="درحال ورود به Cursed Ship...", Duration=3})
                    CommF:InvokeServer("requestEntrance", CursedShipEntranceCF)
                    task.wait(2)
                    State.HellfirePhase = "Farming"

                elseif State.HellfirePhase == "Farming" then
                    if State.EctoCount >= 100 and State.HasTorch then
                        State.HellfirePhase = "GoingNPC"
                        WindUI:Notify({Title="Hellfire Torch", Content="شرایط کامل شد! حرکت به سمت NPC...", Duration=3})
                        continue
                    end

                    local fm, md = nil, math.huge
                    local shipMobs = {"Ship Deckhand", "Ship Engineer", "Ship Steward", "Ship Officer"}
                    local E = Workspace:FindFirstChild("Enemies")
                    if E then
                        for _, v in pairs(E:GetChildren()) do
                            for _, mName in ipairs(shipMobs) do
                                if string.find(v.Name, mName) and IsEnemyValid(v) then
                                    local d = (root.Position - v.HumanoidRootPart.Position).Magnitude
                                    if d < md then md = d; fm = v end
                                end
                            end
                        end
                    end

                    if fm then
                        PrepareEnemyForBoss(fm)
                        State.HellfireTarget = fm
                        local EP = fm.HumanoidRootPart.Position
                        local d = (root.Position - EP); d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude < 0.1 then d = Vector3.new(1, 0, 0) end; d = d.Unit
                        local dest = CFrame.lookAt(EP + d * (Settings.AttackDistance or 10) + Vector3.new(0, Settings.AttackHeight or 10, 0), EP)

                        if (root.Position - dest.Position).Magnitude > 10 then
                            State.ActiveTween = SmartTween(root, dest, State.ActiveTween)
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                            root.CFrame = dest
                            EquipWeaponGeneral()
                            if fm:FindFirstChild("Head") then Workspace.CurrentCamera.CFrame = CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, fm.Head.Position) end
                            
                            local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
                            VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1)
                            task.wait(Settings.HoldTime or 0.01)
                            VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)
                            if RegisterAttack then RegisterAttack:FireServer(math.floor((0.5 + math.random() * 0.5) * 10000) / 10000) end
                        end
                    else
                        local waitCF = CFrame.new(921, 126, 32832) * CFrame.new(0, 40, 0)
                        if (root.Position - waitCF.Position).Magnitude > 15 then
                            State.ActiveTween = SmartTween(root, waitCF, State.ActiveTween)
                        end
                    end

                elseif State.HellfirePhase == "GoingNPC" then
                    EquipToolByName("Hellfire Torch")
                    if (root.Position - HellfireNPCCFrame.Position).Magnitude > 12 then
                        State.ActiveTween = SmartTween(root, HellfireNPCCFrame, State.ActiveTween)
                    else
                        if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                        root.CFrame = HellfireNPCCFrame
                        State.HellfirePhase = "Dialogue"
                    end

                elseif State.HellfirePhase == "Dialogue" then
                    WindUI:Notify({Title="Hellfire Torch", Content="در حال گفتگو با NPC...", Duration=3})
                    
                    local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
                    VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)

                    task.wait(1)
                    local dialogue = GetDialogueUI()
                    if dialogue then
                        local btnWhat = WaitForOptionWithText(dialogue, "what", 5)
                        if btnWhat then ForceClickGUI(btnWhat) end
                        
                        task.wait(1)
                        dialogue = GetDialogueUI()
                        if dialogue then
                            local btnTrade = WaitForOptionWithText(dialogue, "trade", 5)
                            if btnTrade then ForceClickGUI(btnTrade) end
                        end
                        
                        task.wait(2)
                        dialogue = GetDialogueUI()
                        if dialogue then ForceClickGUI(dialogue) end
                    end

                    State.AutoHellfire = false
                    State.HellfirePhase = "Idle"
                    if State.IsDoingPriorityTask then
                        State.IsDoingPriorityTask = false
                        ResumeFarms()
                        WindUI:Notify({Title="Hellfire Torch", Content="عملیات با موفقیت پایان یافت!", Duration=5})
                    end
                end
            end
        end)

        -- ۲. اتو فارم اختصاصی Ectoplasm Mobs
        task.spawn(function()
            local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
            while task.wait(0.1) do
                if not State.AutoEctoFarm then continue end
                local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                if not root then continue end

                local inShip = (root.Position - CursedShipCenter).Magnitude < 3000
                if not inShip then
                    CommF:InvokeServer("requestEntrance", CursedShipEntranceCF)
                    task.wait(2)
                    continue
                end

                local fm, md = nil, math.huge
                local shipMobs = {"Ship Deckhand", "Ship Engineer", "Ship Steward", "Ship Officer"}
                local E = Workspace:FindFirstChild("Enemies")
                if E then
                    for _, v in pairs(E:GetChildren()) do
                        for _, mName in ipairs(shipMobs) do
                            if string.find(v.Name, mName) and IsEnemyValid(v) then
                                local d = (root.Position - v.HumanoidRootPart.Position).Magnitude
                                if d < md then md = d; fm = v end
                            end
                        end
                    end
                end

                if fm then
                    PrepareEnemyForBoss(fm)
                    State.EctoFarmTarget = fm
                    local EP = fm.HumanoidRootPart.Position
                    local d = (root.Position - EP); d = Vector3.new(d.X, 0, d.Z)
                    if d.Magnitude < 0.1 then d = Vector3.new(1, 0, 0) end; d = d.Unit
                    local dest = CFrame.lookAt(EP + d * (Settings.AttackDistance or 10) + Vector3.new(0, Settings.AttackHeight or 10, 0), EP)

                    if (root.Position - dest.Position).Magnitude > 10 then
                        State.ActiveTween = SmartTween(root, dest, State.ActiveTween)
                    else
                        if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                        root.CFrame = dest
                        EquipWeaponGeneral()
                        if fm:FindFirstChild("Head") then Workspace.CurrentCamera.CFrame = CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, fm.Head.Position) end
                        
                        local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
                        VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1)
                        task.wait(Settings.HoldTime or 0.01)
                        VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)
                        if RegisterAttack then RegisterAttack:FireServer(math.floor((0.5 + math.random() * 0.5) * 10000) / 10000) end
                    end
                else
                    local waitCF = CFrame.new(921, 126, 32832) * CFrame.new(0, 40, 0)
                    if (root.Position - waitCF.Position).Magnitude > 15 then
                        State.ActiveTween = SmartTween(root, waitCF, State.ActiveTween)
                    end
                end
            end
        end)

        -- ۳. مانیتورینگ نوتیفیکیشن کرسد کپتن
        task.spawn(function()
            local Notifications = Plr:WaitForChild("PlayerGui"):WaitForChild("Notifications", 10)
            if Notifications then
                Notifications.ChildAdded:Connect(function(child)
                    if not State.AutoCursedCaptain then return end
                    task.wait(0.1)
                    local txt = ""
                    if child:IsA("TextLabel") then txt = child.Text else for _, desc in pairs(child:GetDescendants()) do if desc:IsA("TextLabel") then txt = desc.Text; break end end end
                    
                    if string.find(string.lower(txt), "a shiver runs down your spine") then
                        if not State.IsDoingPriorityTask then
                            State.IsDoingPriorityTask = true
                            PauseFarms()
                            if SetFarmMode then SetFarmMode("CursedCaptain") end
                            State.CursedCaptainPhase = "Entering"
                            WindUI:Notify({Title="Cursed Captain", Content="کرسد کپتن اسپان شد! حرکت به سمت Cursed Ship...", Duration=5})
                        end
                    end
                end)
            end
        end)

        -- ۴. لوپ شکار کرسد کپتن (با پشتیبانی کامل از اسپاون و اسپاون مجدد پس از مردن)
        task.spawn(function()
            local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
            while task.wait(0.1) do
                if not State.AutoCursedCaptain then
                    if State.CursedCaptainPhase ~= "Idle" then
                        State.CursedCaptainPhase = "Idle"
                        if State.IsDoingPriorityTask then State.IsDoingPriorityTask = false; ResumeFarms() end
                    end
                    continue
                end

                local hum = Plr.Character and Plr.Character:FindFirstChild("Humanoid")
                local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")

                if not hum or hum.Health <= 0 or not root then
                    if State.CursedCaptainPhase == "Hunting" then
                        State.CursedCaptainPhase = "Respawning"
                    end
                    task.wait(1)
                    continue
                end

                if State.CursedCaptainPhase == "Respawning" then
                    task.wait(2)
                    CommF:InvokeServer("requestEntrance", CursedShipEntranceCF)
                    task.wait(2)
                    State.CursedCaptainPhase = "Hunting"
                end

                if State.CursedCaptainPhase == "Entering" then
                    CommF:InvokeServer("requestEntrance", CursedShipEntranceCF)
                    task.wait(2)
                    State.CursedCaptainPhase = "Hunting"

                elseif State.CursedCaptainPhase == "Hunting" then
                    local boss = nil
                    if Workspace:FindFirstChild("Enemies") then
                        for _, v in pairs(Workspace.Enemies:GetChildren()) do
                            if string.find(v.Name, "Cursed Captain") and IsEnemyValid(v) then boss = v; break end
                        end
                    end

                    if boss then
                        PrepareEnemyForBoss(boss)
                        State.CursedCaptainTarget = boss
                        local EP = boss.HumanoidRootPart.Position
                        local d = (root.Position - EP); d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude < 0.1 then d = Vector3.new(1, 0, 0) end; d = d.Unit
                        local dest = CFrame.lookAt(EP + d * (Settings.AttackDistance or 10) + Vector3.new(0, Settings.AttackHeight or 10, 0), EP)

                        if (root.Position - dest.Position).Magnitude > 10 then
                            State.ActiveTween = SmartTween(root, dest, State.ActiveTween)
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                            root.CFrame = dest
                            EquipWeaponGeneral()
                            if boss:FindFirstChild("Head") then Workspace.CurrentCamera.CFrame = CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, boss.Head.Position) end
                            
                            local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
                            VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1)
                            task.wait(Settings.HoldTime or 0.01)
                            VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)
                            if RegisterAttack then RegisterAttack:FireServer(math.floor((0.5 + math.random() * 0.5) * 10000) / 10000) end
                        end
                    else
                        State.CursedCaptainPhase = "Idle"
                        State.CursedCaptainTarget = nil
                        if State.IsDoingPriorityTask then
                            State.IsDoingPriorityTask = false
                            ResumeFarms()
                            WindUI:Notify({Title="Cursed Captain", Content="کرسد کپتن شکست داده شد! بازگشت به فارم...", Duration=5})
                        end
                    end
                end
            end
        end)
    end

    -- ========================================================
    -- ساخت المان‌های UI در بخش‌ها
    -- ========================================================
    if Sea == 2 then
        if BossTab then
            local DarkbeardSec = BossTab:Section({Title = " اتو دارک بیرد (Darkbeard)", Box = true, BoxBorder = true, Opened = true})
            DarkbeardSec:Toggle({Title = "اتو اسپان و کشتن Darkbeard", Value = false, Callback = function(s) State.AutoDarkbeardEnabled = s end})
            DarkbeardSec:Toggle({Title = "کشتن دارک برید وقتی اسپان شد", Value = false, Callback = function(s) State.AutoKillDarkbeardEventEnabled = s end})
        end

        if RaceTab then
            local BartiloSec = RaceTab:Section({Title = "کوئست بارتیلو (رِیس V2)", Box = true, BoxBorder = true, Opened = true})
            BartiloSec:Toggle({
                Title = "انجام خودکار کوئست بارتیلو", 
                Desc = "به صورت کاملاً خودکار کوئست می‌گیرد، ماب‌ها را می‌کشد، جرمی را می‌کشد و روی پلت‌ها می‌رود.",
                Value = false, 
                Callback = function(s) 
                    if ExtraModule1.ToggleBartilo then ExtraModule1.ToggleBartilo(s) end 
                end
            })

            local HellfireSec = RaceTab:Section({Title = "پازل هل‌فایر (Hellfire Torch)", Box = true, BoxBorder = true, Opened = true})
            HellfireSec:Toggle({
                Title = "اتو پازل Hellfire Torch",
                Desc = "به طور خودکار وارد کشتی می‌شود، Ectoplasm فارم می‌کند، Torch می‌گیرد و پازل را با NPC حل می‌کند.",
                Value = false,
                Callback = function(s) ExtraModule1.ToggleHellfire(s) end
            })

            local CaptainSec = RaceTab:Section({Title = "شکار Cursed Captain", Box = true, BoxBorder = true, Opened = true})
            CaptainSec:Toggle({
                Title = "شکار خودکار Cursed Captain",
                Desc = "با اسپاون شدن کرسد کپتن، فارم متوقف شده و به سمت کشتن باس می‌رود.",
                Value = false,
                Callback = function(s) ExtraModule1.ToggleCursedCaptain(s) end
            })
        end

        if MainSection then
            local EctoSec = MainSection:Section({Title = "فارم ماب‌های اکتوپلاسم (Cursed Ship)", Box = true, BoxBorder = true, Opened = true})
            EctoSec:Toggle({
                Title = "شروع فارم ماب‌های Cursed Ship",
                Desc = "وارد کشتی شده و ماب‌ها را جهت دریافت Ectoplasm می‌کشد.",
                Value = false,
                Callback = function(s) ExtraModule1.ToggleEctoFarm(s) end
            })
        end
    end

    return ExtraModule1
end

return ExtraModule1
