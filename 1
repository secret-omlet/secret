    local function EquipWeaponGeneral()
        pcall(function()
            local h = Plr.Character:FindFirstChild("Humanoid")
            if not h then return end
            local current = Plr.Character:FindFirstChildOfClass("Tool")
            if current and (current.ToolTip == "Melee" or current.ToolTip == "Sword" or current.ToolTip == "Blox Fruit") then return end
            for _, t in pairs(Plr.Backpack:GetChildren()) do 
                if t:IsA("Tool") and (t.ToolTip == "Sword" or t.ToolTip == "Blox Fruit" or t.ToolTip == "Melee") then 
                    h:EquipTool(t); break 
                end 
            end
        end)
    end

    local function PrepareEnemyForBoss(E)
        pcall(function()
            if not E or not E.Parent or not E:FindFirstChild("HumanoidRootPart") then return end
            local H = E:FindFirstChild("Head")
            if H and not E:FindFirstChild("FakeHead") then
                local FH = H:Clone(); FH.Name = "FakeHead"; FH.CanCollide = false; FH.Massless = true; FH.Size = H.Size; FH.Transparency = H.Transparency; FH.Parent = E
                local W = Instance.new("WeldConstraint"); W.Part0 = H; W.Part1 = FH; W.Parent = FH
                H.Size = Vector3.new(Settings.HeadSize or 100, Settings.HeadSize or 100, Settings.HeadSize or 100); H.Transparency = 1; H.CanCollide = false
                for _, c in pairs(H:GetChildren()) do if c:IsA("SpecialMesh") or c:IsA("Decal") then c:Destroy() end end
            end
            local hum = E:FindFirstChild("Humanoid")
            if hum then hum.WalkSpeed = 0; hum.JumpPower = 0; if hum:FindFirstChild("Animator") then hum.Animator:Destroy() end end
            for _, p in pairs(E:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        end)
    end

    local function HasQuest() 
        local g = Plr.PlayerGui:FindFirstChild("Main") 
        return g and g:FindFirstChild("Quest") and g.Quest.Visible or false 
    end
    local function IsEnemyValid(E)
        return E and E.Parent and E:FindFirstChild("Humanoid") and E.Humanoid.Health > 0 and E:FindFirstChild("HumanoidRootPart") ~= nil
    end
    local function IsBossAlive(n)
        local E = Workspace:FindFirstChild("Enemies")
        if E then for _, v in pairs(E:GetChildren()) do if string.find(v.Name, n) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then return true end end end
        return false
    end
    local function IsBossSpawned(n)
        local W = Workspace:FindFirstChild("_WorldOrigin")
        if W and W:FindFirstChild("EnemySpawns") then for _, v in pairs(W.EnemySpawns:GetChildren()) do if string.find(v.Name, n) then return true end end end
        return IsBossAlive(n)
    end
    local function GetRealSpawn(name, fallbackCFrame)
        local W = Workspace:FindFirstChild("_WorldOrigin")
        if W and W:FindFirstChild("EnemySpawns") then for _, v in pairs(W.EnemySpawns:GetChildren()) do if string.find(v.Name, name) then return v.CFrame end end end
        return fallbackCFrame
    end

    local function HandleDialogueQuick()
        pcall(function()
            local D = Plr.PlayerGui:FindFirstChild("Main") and Plr.PlayerGui.Main:FindFirstChild("Dialogue")
            if D and D.Visible then
                local cancelBtn = D:FindFirstChild("Cancel")
                if cancelBtn and cancelBtn.Visible then
                    local p = cancelBtn.AbsolutePosition; local s = cancelBtn.AbsoluteSize; local I = game:GetService("GuiService"):GetGuiInset()
                    VirtualInputManager:SendMouseButtonEvent(p.X+s.X/2, p.Y+s.Y/2+I.Y, 0, true, game, 1); task.wait(0.05); VirtualInputManager:SendMouseButtonEvent(p.X+s.X/2, p.Y+s.Y/2+I.Y, 0, false, game, 1)
                else
                    local p = D.AbsolutePosition; local s = D.AbsoluteSize; local I = game:GetService("GuiService"):GetGuiInset()
                    VirtualInputManager:SendMouseButtonEvent(p.X+s.X/2, p.Y+s.Y/2+I.Y, 0, true, game, 1); task.wait(0.05); VirtualInputManager:SendMouseButtonEvent(p.X+s.X/2, p.Y+s.Y/2+I.Y, 0, false, game, 1)
                end
            end
        end)
    end

    ExtraModule1.ToggleDragonTalon = function(s)
        if s then
            local beli = Plr.Data.Beli.Value
            local frags = Plr.Data.Fragments.Value
            if beli < 3000000 then WindUI:Notify({Title="خطا", Content="پول شما کمتر از 3 میلیون است!", Duration=5}); return end
            if frags < 5000 then WindUI:Notify({Title="خطا", Content="فرگمنت شما کمتر از 5000 است!", Duration=5}); return end
            
            local char = Plr.Character
            local meleeTool = nil
            if char then
                local t = char:FindFirstChildOfClass("Tool")
                if t and t.ToolTip == "Melee" then meleeTool = t end
            end
            if not meleeTool then
                for _, t in ipairs(Plr.Backpack:GetChildren()) do
                    if t:IsA("Tool") and t.ToolTip == "Melee" then meleeTool = t; break end
                end
            end
            if not meleeTool then WindUI:Notify({Title="خطا", Content="هیچ میلی در کیف یا دست شما نیست!", Duration=5}); return end
            local lowerName = string.lower(meleeTool.Name)
            if not (string.find(lowerName, "dragon claw") or string.find(lowerName, "dragonbreath")) then
                WindUI:Notify({Title="خطا", Content="میلی فعلی شما Dragon Breath نیست!", Duration=5}); return 
            end
            local masteryVal = meleeTool:FindFirstChild("Level")
            local mastery = masteryVal and masteryVal.Value or 0
            if mastery < 400 then
                WindUI:Notify({Title="خطا", Content="مستری Dragon Breath شما " .. tostring(mastery) .. " است (باید بالای 400 باشد)!", Duration=5}); return 
            end

            State.AutoDragonTalon = true
            WindUI:Notify({Title="دراگون تالون", Content="تایید شد! استارت خودکار فارم استخوان...", Duration=5})
            if getgenv().Extra1_StartBones then getgenv().Extra1_StartBones() end
        else
            State.AutoDragonTalon = false
        end
    end

    ExtraModule1.ToggleBartilo = function(s)
        State.AutoBartilo = s
        if s then
            State.BartiloPhase = -1
            State.BartiloPlateIndex = 1
            if not State.IsDoingPriorityTask then
                State.IsDoingPriorityTask = true
                PauseFarms()
                if SetFarmMode then SetFarmMode("BartiloQuest") end
            end
            WindUI:Notify({Title="Bartilo Quest", Content="سیستم کوئست بارتیلو روشن شد!", Duration=3})
        else
            State.BartiloTarget = nil
            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
            if State.IsDoingPriorityTask and (SetFarmMode and (Core and Core.FarmMode == "BartiloQuest" or true)) then 
                State.IsDoingPriorityTask = false
                ResumeFarms() 
            end
        end
    end

    if Sea == 3 then
        task.spawn(function()
            local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
            while task.wait(1) do
                if State.AutoDragonTalon then
                    local hasFireEssence = Plr.Backpack:FindFirstChild("Fire Essence") or (Plr.Character and Plr.Character:FindFirstChild("Fire Essence"))
                    if hasFireEssence then
                        State.AutoDragonTalon = false
                        if TurnOffAll then TurnOffAll() end 
                        WindUI:Notify({Title="دراگون تالون", Content="Fire Essence بدست آمد! حرکت به سمت NPC...", Duration=5})
                        local targetPos = CFrame.new(5661.079, 1207.626, 866.298)
                        local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                        if root then
                            if State.ActiveTween then State.ActiveTween:Cancel() end
                            State.ActiveTween = TweenService:Create(root, TweenInfo.new(math.max((root.Position - targetPos.Position).Magnitude/350, 0.1), Enum.EasingStyle.Linear), {CFrame = targetPos})
                            State.ActiveTween:Play()
                            State.ActiveTween.Completed:Wait()
                            task.wait(1)
                            CommF:InvokeServer("BuyDragonTalon")
                            WindUI:Notify({Title="موفقیت", Content="شمشیر/میلی Dragon Talon خریداری شد!", Duration=10})
                        end
                    else
                        pcall(function()
                            local bonesData = CommF:InvokeServer("Bones", "Check")
                            local currentBones = tonumber(bonesData) or 0
                            if currentBones >= 50 then CommF:InvokeServer("Bones", "Buy", 1, 1) end
                        end)
                    end
                end
            end
        end)
    end
    if Sea == 3 and BoneSec then
        task.spawn(function()
            local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
            while task.wait(2) do
                if State.AutoBuyBones and State.SoulReaperPhase == "Idle" and not State.IsDoingPriorityTask and not State.AutoDragonTalon then
                    pcall(function()
                        local bonesData = CommF:InvokeServer("Bones", "Check")
                        local currentBones = tonumber(bonesData) or 0
                        if currentBones >= 100 then
                            local timesToBuy = math.floor(currentBones / 100)
                            for i = 1, timesToBuy do
                                if not State.AutoBuyBones or State.IsDoingPriorityTask then break end
                                CommF:InvokeServer("Bones", "Buy", 1, 1)
                                task.wait(1.5)
                            end
                        end
                    end)
                end
            end
        end)

        task.spawn(function()
            local Notifications = Plr:WaitForChild("PlayerGui"):WaitForChild("Notifications", 10)
            if Notifications then
                Notifications.ChildAdded:Connect(function(child)
                    if not State.AutoKillReaperNotif then return end
                    task.wait(0.1)
                    local txt = ""
                    if child:IsA("TextLabel") then txt = child.Text else for _, desc in pairs(child:GetDescendants()) do if desc:IsA("TextLabel") then txt = desc.Text; break end end end
                    
                    if string.find(txt, "An unknown being has entered this world") then
                        if not State.IsDoingPriorityTask then
                            State.IsDoingPriorityTask = true
                            PauseFarms()
                            if SetFarmMode then SetFarmMode("SoulReaper") end
                            State.SoulReaperPhase = "Attacking"
                            WindUI:Notify({Title="Soul Reaper", Content="سول ریپر اسپان شد! توقف فارم و حرکت...", Duration=5})
                        end
                    end
                end)
            end
        end)

        task.spawn(function()
            while task.wait(0.1) do
                if not State.AutoSpawnSoulReaper and not State.AutoKillReaperNotif then
                    if State.SoulReaperPhase ~= "Idle" then
                        State.SoulReaperPhase = "Idle"
                        if State.IsDoingPriorityTask then State.IsDoingPriorityTask = false; ResumeFarms() end
                    end
                    continue
                end

                local hasEssence = Plr.Backpack:FindFirstChild("Hallow Essence") or (Plr.Character and Plr.Character:FindFirstChild("Hallow Essence"))

                if State.AutoSpawnSoulReaper and State.SoulReaperPhase == "Idle" and hasEssence then
                    if not State.IsDoingPriorityTask then
                        State.IsDoingPriorityTask = true
                        PauseFarms()
                        if SetFarmMode then SetFarmMode("SoulReaper") end
                        State.SoulReaperPhase = "Spawning"
                        WindUI:Notify({Title="Soul Reaper", Content="آیتم Hallow Essence پیدا شد! حرکت به سمت محراب...", Duration=5})
                    end
                end

                if State.SoulReaperPhase == "Spawning" then
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - ReaperAltarPos.Position).Magnitude
                        if dist > 15 then
                            State.ActiveTween = SmartTween(root, ReaperAltarPos, State.ActiveTween)
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                            root.CFrame = ReaperAltarPos
                            local ess = Plr.Backpack:FindFirstChild("Hallow Essence")
                            if ess and Plr.Character:FindFirstChild("Humanoid") then Plr.Character.Humanoid:EquipTool(ess) end
                            task.wait(2) 
                            State.SoulReaperPhase = "Attacking"
                        end
                    end
                    
                elseif State.SoulReaperPhase == "Attacking" then
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if not root then continue end

                    local reaper = nil
                    if Workspace:FindFirstChild("Enemies") then
                        for _, v in pairs(Workspace.Enemies:GetChildren()) do
                            if string.find(v.Name, "Soul Reaper") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then reaper = v; break end
                        end
                    end
                    
                    if reaper then
                        State.SoulReaperWaitTimer = nil 
                        PrepareEnemyForBoss(reaper)
                        
                        local ep = reaper.HumanoidRootPart.Position
                        local d = (root.Position - ep); d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude < 0.1 then d = Vector3.new(1,0,0) end; d = d.Unit
                        local dest = CFrame.lookAt(ep + d * (Settings.AttackDistance or 40) + Vector3.new(0, (Settings.AttackHeight or 40), 0), ep)
                        
                        if (root.Position - dest.Position).Magnitude > 10 then 
                            State.ActiveTween = SmartTween(root, dest, State.ActiveTween)
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                            root.CFrame = dest
                            EquipWeaponGeneral()
                            if reaper:FindFirstChild("Head") then Workspace.CurrentCamera.CFrame = CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, reaper.Head.Position) end
                            
                            task.spawn(function()
                                local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
                                for i=1,3 do
                                    VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1); task.wait(Settings.HoldTime or 0.05); VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)
                                    if RegisterAttack then RegisterAttack:FireServer(math.floor((0.5 + math.random() * 0.5) * 10000) / 10000) end
                                end
                            end)
                        end
                    else
                        if not State.SoulReaperWaitTimer then State.SoulReaperWaitTimer = tick() end
                        if (root.Position - ReaperArenaPos.Position).Magnitude > 15 then
                            State.ActiveTween = SmartTween(root, ReaperArenaPos, State.ActiveTween)
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                        end

                        if tick() - State.SoulReaperWaitTimer > 15 then
                            State.SoulReaperPhase = "Idle"
                            State.SoulReaperWaitTimer = nil
                            if State.IsDoingPriorityTask then State.IsDoingPriorityTask = false; ResumeFarms(); WindUI:Notify({Title="Soul Reaper", Content="عملیات پایان یافت! بازگشت به فارم...", Duration=5}) end
                        end
                    end
                end
            end
        end)
    end

    -- ========================================================
    -- هسته Noclip (رد شدن از دیوار موقع اتک)
    -- ========================================================
    RunService.Heartbeat:Connect(function()
        pcall(function()
            if (State.DarkbeardState == "Attacking" or State.SoulReaperPhase == "Attacking" or (State.AutoBartilo and State.BartiloTarget)) and Plr.Character then
                for _, p in pairs(Plr.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
                if Plr.Character:FindFirstChild("HumanoidRootPart") then Plr.Character.HumanoidRootPart.Velocity = Vector3.zero end
            end
        end)
    end)

    if Sea == 2 or Sea == 3 then
        task.spawn(function()
            while task.wait(1) do
                if State.StopChestOnSpecialItem then
                    local shouldStop, itemName = false, ""
                    if Sea == 2 then
                        itemName = "Fist of Darkness"
                        if Plr.Backpack:FindFirstChild(itemName) or (Plr.Character and Plr.Character:FindFirstChild(itemName)) then shouldStop = true end
                    elseif Sea == 3 then
                        itemName = "God's Chalice"
                        if Plr.Backpack:FindFirstChild(itemName) or (Plr.Character and Plr.Character:FindFirstChild(itemName)) then shouldStop = true end
                    end
                    if shouldStop then
                        State.StopChestOnSpecialItem = false 
                        PauseFarms()
                        if SetFarmMode then SetFarmMode("None") end
                        WindUI:Notify({Title="توقف خودکار چست", Content="آیتم " .. itemName .. " گرفته شد! اسکریپت متوقف شد.", Duration=5})
                    end
                end
            end
        end)
    end

    -- ========================================================
    -- هوش مصنوعی Bartilo Quest
    -- ========================================================
    if Sea == 2 then
        task.spawn(function()
            while task.wait(3) do
                if State.AutoBartilo and not State.BartiloIsChecking then
                    pcall(function()
                        State.BartiloIsChecking = true
                        local progress = ReplicatedStorage.Remotes.CommF_:InvokeServer("BartiloQuestProgress", "Bartilo")
                        progress = tonumber(progress)
                        if progress and (State.BartiloPhase == -1 or progress > State.BartiloPhase) then State.BartiloPhase = progress end
                        State.BartiloIsChecking = false
                    end)
                end
            end
        end)

        -- لوپ تشخیص حرکت بارتیلو
        task.spawn(function()
            while task.wait(0.1) do
                if not State.AutoBartilo or State.BartiloIsChecking then continue end
                local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                if not root then continue end

                if State.BartiloPhase == -1 then continue end

                if State.BartiloPhase == 0 then
                    if not HasQuest() then
                        State.BartiloTarget = {Mode = "Move", CFrame = BartiloQuestPos}
                        if (root.Position - BartiloQuestPos.Position).Magnitude < 15 then
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BartiloQuest", 1)
                            task.wait(1)
                            HandleDialogueQuick()
                        end
                    else
                        local fm, md = nil, math.huge
                        local E = Workspace:FindFirstChild("Enemies")
                        if E then
                            for _, v in pairs(E:GetChildren()) do
                                if string.find(v.Name, "Swan Pirate") and IsEnemyValid(v) then
                                    local d = (root.Position - v.HumanoidRootPart.Position).Magnitude
                                    if d < md then md = d; fm = v end
                                end
                            end
                        end
                        if fm then
                            PrepareEnemyForBoss(fm)
                            State.BartiloTarget = {Mode = "Mob", Instance = fm}
                        else
                            local realPos = GetRealSpawn("Swan Pirate", SwanPirateArea)
                            State.BartiloTarget = {Mode = "Wait", CFrame = realPos * CFrame.new(0, Settings.WaitHeight or 40, 0)}
                        end
                    end
                elseif State.BartiloPhase == 1 then
                    local jeremyInstance = nil
                    local E = Workspace:FindFirstChild("Enemies")
                    if E then
                        for _, v in pairs(E:GetChildren()) do
                            if string.find(v.Name, "Jeremy") and IsEnemyValid(v) then jeremyInstance = v; break end
                        end
                    end
                    if jeremyInstance then
                        PrepareEnemyForBoss(jeremyInstance)
                        State.BartiloTarget = {Mode = "Mob", Instance = jeremyInstance}
                    else
                        local realJeremyPos = GetRealSpawn("Jeremy", JeremyQuestNPC)
                        State.BartiloTarget = {Mode = "Wait", CFrame = realJeremyPos * CFrame.new(0, Settings.WaitHeight or 40, 0)}
                    end
                elseif State.BartiloPhase == 2 then
                    if State.BartiloPlateIndex <= #BartiloPlates then
                        local targetPlate = BartiloPlates[State.BartiloPlateIndex]
                        State.BartiloTarget = {Mode = "Move", CFrame = targetPlate}
                        if (root.Position - targetPlate.Position).Magnitude < 20 then
                            task.wait(0.3)
                            State.BartiloPlateIndex = State.BartiloPlateIndex + 1
                        end
                    else
                        pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("BartiloQuestProgress", "DidPlates") end)
                        State.BartiloPhase = 3
                    end
                elseif State.BartiloPhase == 3 then
                    State.BartiloTarget = nil
                    if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                    State.AutoBartilo = false
                    WindUI:Notify({Title="Bartilo Quest", Content="کوئست بارتیلو با موفقیت کامل شد!", Duration=5})
                    if State.IsDoingPriorityTask then State.IsDoingPriorityTask = false; ResumeFarms() end
                end
            end
        end)

        -- لوپ حرکت پروازی بارتیلو
        task.spawn(function()
            while task.wait(0.1) do
                pcall(function()
                    if not State.AutoBartilo or not State.BartiloTarget then return end
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    
                    local dest = nil
                    if State.BartiloTarget.Mode == "Move" or State.BartiloTarget.Mode == "Wait" then
                        dest = State.BartiloTarget.CFrame
                    elseif State.BartiloTarget.Mode == "Mob" and State.BartiloTarget.Instance and State.BartiloTarget.Instance:FindFirstChild("HumanoidRootPart") then
                        local EP = State.BartiloTarget.Instance.HumanoidRootPart.Position
                        local d = (root.Position - EP); d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude < 0.1 then d = Vector3.new(1,0,0) end; d = d.Unit
                        dest = CFrame.lookAt(EP + d * (Settings.AttackDistance or 10) + Vector3.new(0, (Settings.AttackHeight or 10), 0), EP)
                    end

                    if dest then
                        local dist = (root.Position - dest.Position).Magnitude
                        if dist >= 10 then 
                            State.ActiveTween = SmartTween(root, dest, State.ActiveTween)
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                        end
                    end
                end)
            end
        end)

        -- ========================================================
        -- لوپ اتک دادن بارتیلو با تایمینگ دقیقا مشابه Level Up
        -- ========================================================
        task.spawn(function()
            while true do
                local Clicked = false
                pcall(function()
                    if not State.AutoBartilo or not State.BartiloTarget or State.BartiloTarget.Mode ~= "Mob" then return end
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    
                    local E = State.BartiloTarget.Instance
                    if not IsEnemyValid(E) then return end
                    
                    -- تاخیر 2 ثانیه ای هوشمند (هنگام عوض شدن تارگت) دقیقا مشابه هاب شما
                    if E ~= State.BartiloLastEnemy then 
                        State.BartiloLastEnemy = E
                        State.BartiloLastEnemyTime = tick() 
                    end
                    if tick() - State.BartiloLastEnemyTime < (Settings.AttackWaitTime or 2) then return end
                    
                    -- بررسی فاصله از ماب
                    local EP = E:FindFirstChild("HumanoidRootPart") and E.HumanoidRootPart.Position
                    if EP then
                        local d = (root.Position - EP)
                        d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude < 0.1 then d = Vector3.new(1,0,0) end
                        local dest = EP + d.Unit * (Settings.AttackDistance or 10) + Vector3.new(0, Settings.AttackHeight or 10, 0)
                        
                        if (root.Position - dest).Magnitude < 15 then
                            EquipWeaponGeneral()
                            if E:FindFirstChild("Head") then Workspace.CurrentCamera.CFrame = CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, E.Head.Position) end
                            
                            local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
                            VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1)
                            task.wait(Settings.HoldTime or 0.01)
                            VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)
                            
                            if RegisterAttack then 
                                RegisterAttack:FireServer(math.floor((0.5 + math.random() * 0.5) * 10000) / 10000) 
                            end
                            Clicked = true
                        end
                    end
                end)
                
                -- سیستم دیلی اتک هوشمند که در اسکریپت LevelUp شما هست
                if Clicked then
                    local minDelay = Settings.MinClickDelay or 0.05
                    local maxDelay = Settings.MaxClickDelay or 0.09
                    local delay = minDelay + (math.random() * (maxDelay - minDelay))
                    task.wait(delay)
                else
                    task.wait(0.15)
                end
            end
        end)
    end

    if Sea == 2 then
        if BossTab then
            local DarkbeardSec = BossTab:Section({Title = " اتو دارک بیرد (Darkbeard)", Box = true, BoxBorder = true, Opened = true})
            DarkbeardSec:Toggle({Title = "اتو اسپان و کشتن Darkbeard", Value = false, Callback = function(s) State.AutoDarkbeardEnabled = s end})
            DarkbeardSec:Toggle({Title = "کشتن دارک برید وقتی اسپان شد", Value = false, Callback = function(s) State.AutoKillDarkbeardEventEnabled = s end})
        end
        
        if RaceTab then
            local BartiloSec = RaceTab:Section({Title = "کوئست بارتیلو (رِیس V2)", Box = true, BoxBorder = true, Opened = true})
            BartiloSec:Toggle({
                Title = "انجام خودکار کوئست بارتیلو", 
                Desc = "به صورت کاملاً خودکار کوئست می‌گیرد، ماب‌ها را می‌کشد، جرمی را می‌کشد و روی پلت‌ها می‌رود.",
                Value = false, 
                Callback = function(s) 
                    if ExtraModule1.ToggleBartilo then ExtraModule1.ToggleBartilo(s) end 
                end
            })
        end
    end
end

return ExtraModule1
