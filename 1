local ExtraModule1 = {}

function ExtraModule1.Init(Deps)
    local Plr = Deps.Plr
    local Workspace = Deps.Workspace
    local ReplicatedStorage = Deps.ReplicatedStorage
    local VirtualInputManager = Deps.VirtualInputManager
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local Lighting = game:GetService("Lighting") 
    
    local Sea = Deps.Sea
    local WindUI = Deps.WindUI
    local BossTab = Deps.BossTab
    local ChestSection = Deps.ChestSection
    local MainSection = Deps.MainSection 
    local BoneSec = Deps.BoneSec
    local FSTab = Deps.FSTab -- دریافت تب فایتینگ استایل
    local TurnOffAll = Deps.TurnOffAll 
    
    local PauseFarms = Deps.PauseFarms
    local ResumeFarms = Deps.ResumeFarms
    local SetFarmMode = Deps.SetFarmMode
    local SmartTween = Deps.SmartTween
    local Settings = Deps.Settings
    local RegisterAttack = Deps.RegisterAttack

    local State = {
        StopChestOnSpecialItem = false,
        AutoDarkbeardEnabled = false,
        AutoKillDarkbeardEventEnabled = false,
        DarkbeardState = "Idle",
        DarkbeardWaitTimer = nil,
        ActiveTween = nil,
        IsDoingPriorityTask = false,
        DarkbeardTarget = nil,
        LastTargetEnemy = nil,
        LastTargetTime = 0,
        
        AutoMirageSniper = false,
        AutoMirageChest = false,
        MirageChestFarming = false,
        MirageActiveTween = nil,
        MirageNoclip = nil,
        
        AutoBuyBones = false,
        AutoSpawnSoulReaper = false,
        AutoKillReaperNotif = false,
        SoulReaperPhase = "Idle",
        SoulReaperWaitTimer = nil,
        
        -- دراگون تالون (جدید)
        AutoDragonTalon = false,
    }

    local DarkbeardSpawnPos = CFrame.new(3778.288, 11.682, -3499.631)
    local ReaperAltarPos = CFrame.new(-8932.379, 140.073, 6061.035)
    local ReaperArenaPos = CFrame.new(-9512.133, 312.248, 6784.793)

    local function EquipMeleeOnly()
        pcall(function()
            if not Plr.Character then return end
            local h = Plr.Character:FindFirstChild("Humanoid")
            if not h then return end
            local t = Plr.Character:FindFirstChildOfClass("Tool")
            if t and t.ToolTip == "Melee" then return end
            for _, t2 in pairs(Plr.Backpack:GetChildren()) do 
                if t2:IsA("Tool") and t2.ToolTip == "Melee" then h:EquipTool(t2); return end 
            end
        end)
    end
    
    local function EquipWeaponGeneral()
        pcall(function()
            local h = Plr.Character:FindFirstChild("Humanoid")
            if not h then return end
            local current = Plr.Character:FindFirstChildOfClass("Tool")
            if current and (current.ToolTip == "Melee" or current.ToolTip == "Sword" or current.ToolTip == "Blox Fruit") then return end
            for _, t in pairs(Plr.Backpack:GetChildren()) do 
                if t:IsA("Tool") and (t.ToolTip == "Sword" or t.ToolTip == "Blox Fruit" or t.ToolTip == "Melee") then 
                    h:EquipTool(t); break 
                end 
            end
        end)
    end

    local function PrepareEnemyForBoss(E)
        pcall(function()
            if not E or not E.Parent or not E:FindFirstChild("HumanoidRootPart") then return end
            local H = E:FindFirstChild("Head")
            if H and not E:FindFirstChild("FakeHead") then
                local FH = H:Clone(); FH.Name = "FakeHead"; FH.CanCollide = false; FH.Massless = true; FH.Size = H.Size; FH.Transparency = H.Transparency; FH.Parent = E
                local W = Instance.new("WeldConstraint"); W.Part0 = H; W.Part1 = FH; W.Parent = FH
                H.Size = Vector3.new(Settings.HeadSize or 100, Settings.HeadSize or 100, Settings.HeadSize or 100); H.Transparency = 1; H.CanCollide = false
                for _, c in pairs(H:GetChildren()) do if c:IsA("SpecialMesh") or c:IsA("Decal") then c:Destroy() end end
            end
            local hum = E:FindFirstChild("Humanoid")
            if hum then hum.WalkSpeed = 0; hum.JumpPower = 0; if hum:FindFirstChild("Animator") then hum.Animator:Destroy() end end
            for _, p in pairs(E:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        end)
    end

    -- ========================================================
    -- سیستم میریج
    -- ========================================================
    local MIRAGE_SPEED = 340

    local function MirageTweenTo(targetCFrame)
        local character = Plr.Character or Plr.CharacterAdded:Wait()
        local hrp = character:WaitForChild("HumanoidRootPart")
        
        local distance = (hrp.Position - targetCFrame.Position).Magnitude
        local timeToReach = math.max(distance / MIRAGE_SPEED, 0.1)

        local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
        
        if State.MirageActiveTween then State.MirageActiveTween:Cancel() end
        State.MirageActiveTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})

        if State.MirageNoclip then State.MirageNoclip:Disconnect() end
        State.MirageNoclip = RunService.Stepped:Connect(function()
            if character then
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
                end
            end
        end)

        State.MirageActiveTween:Play()
        State.MirageActiveTween.Completed:Wait()

        if State.MirageNoclip then State.MirageNoclip:Disconnect() end
        hrp.Velocity = Vector3.zero
    end

    local function EmergencyStopAndUnseat()
        if TurnOffAll then
            TurnOffAll()
            WindUI:Notify({Title="میریج", Content="میریج اسپان شد! درحال رفتن به سمت میریج ", Duration=5})
        end
        local char = Plr.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if hum and hum.Sit then
            hum.Sit = false; hum:ChangeState(Enum.HumanoidStateType.Jumping); task.wait(0.5) 
        end
    end

    local function RemoveFogAndBlindness()
        Lighting.FogEnd = 100000; Lighting.FogStart = 0; Lighting.GlobalShadows = false; Lighting.Brightness = 2; Lighting.ClockTime = 12
        for _, v in pairs(Lighting:GetDescendants()) do
            if v:IsA("Atmosphere") then v:Destroy() 
            elseif v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") then v.Enabled = false; v:Destroy() end
        end
    end

    task.spawn(function()
        local mapFolder = Workspace:WaitForChild("Map")
        while task.wait(1) do
            if State.AutoMirageSniper then
                local island = mapFolder:FindFirstChild("MysticIsland")
                if island then
                    EmergencyStopAndUnseat()
                    local targetCFrame = island:GetPivot() * CFrame.new(0, 50, 0)
                    MirageTweenTo(targetCFrame)
                    State.AutoMirageSniper = false 
                end
            end
        end
    end)

    task.spawn(function()
        while task.wait(0.5) do
            if State.AutoMirageChest and not State.MirageChestFarming then
                local mapFolder = Workspace:FindFirstChild("Map")
                local island = mapFolder and mapFolder:FindFirstChild("MysticIsland")
                if island then
                    local chestsFolder = island:FindFirstChild("Chests")
                    if chestsFolder then
                        State.MirageChestFarming = true
                        for _, chest in ipairs(chestsFolder:GetChildren()) do
                            if not State.AutoMirageChest then break end 
                            local touchPart = chest:IsA("BasePart") and chest or chest:FindFirstChildWhichIsA("BasePart", true)
                            if touchPart and touchPart.Transparency < 1 then
                                MirageTweenTo(touchPart.CFrame)
                                task.wait(0.5)
                            end
                        end
                        State.MirageChestFarming = false
                    end
                end
            end
        end
    end)

    if Sea == 3 and MainSection then
        local MirageTab = MainSection:Tab({Title="اتو میریج", Icon="eye", IconColor=Color3.fromHex("#a020f0"), Border=true})
        local MirageStatus = MirageTab:Paragraph({Title="وضعیت جزیره", Desc="در حال بررسی..."})
        
        task.spawn(function()
            local mapF = Workspace:WaitForChild("Map")
            while task.wait(2) do
                if mapF:FindFirstChild("MysticIsland") then MirageStatus:SetDesc("✅ جزیره میریج  اسپان است!")
                else MirageStatus:SetDesc("❌ جزیره میریج اسپان نیست.") end
            end
        end)

        local MirageSec = MirageTab:Section({Title="تنظیمات جزیره", Box=true, BoxBorder=true, Opened=true})
        MirageSec:Toggle({Title = "اتو میریج", Desc = "هر وقت میریج اسپان شد میره سمتش", Value = false, Callback = function(s) State.AutoMirageSniper = s end})
        MirageSec:Toggle({Title = "اتو چست میریج", Desc = "تمام چست های داخل جزیره رو جمع میکنه", Value = false, Callback = function(s) State.AutoMirageChest = s if not s and State.MirageActiveTween then State.MirageActiveTween:Cancel() end end})
        MirageSec:Button({Title = "حذف تاریکی و مه ", Callback = function() pcall(RemoveFogAndBlindness); WindUI:Notify({Title="تاریکی و مه", Content="لیمیت تاریکی و مه برداشته شد", Duration=3}) end})
    end

    -- ========================================================
    -- سیستم اتو دراگون تالون (جدید)
    -- ========================================================
    if Sea == 3 and FSTab then
        FSTab:Toggle({
            Title = "اتو خرید Dragon Talon",
            Desc = "چک کردن پیش‌نیازها -> فارم استخوان -> خرید Fire Essence -> خرید Dragon Talon",
            Value = false,
            Callback = function(s)
                if s then
                    -- 1. بررسی دقیق پیش‌نیازها
                    local beli = Plr.Data.Beli.Value
                    local frags = Plr.Data.Fragments.Value
                    
                    if beli < 3000000 then 
                        WindUI:Notify({Title="خطا", Content="پول شما کمتر از 3 میلیون است!", Duration=5})
                        State.AutoDragonTalon = false; return 
                    end
                    if frags < 5000 then 
                        WindUI:Notify({Title="خطا", Content="فرگمنت شما کمتر از 5000 است!", Duration=5})
                        State.AutoDragonTalon = false; return 
                    end
                    
                    local char = Plr.Character
                    local meleeTool = nil
                    if char then
                        local t = char:FindFirstChildOfClass("Tool")
                        if t and t.ToolTip == "Melee" then meleeTool = t end
                    end
                    if not meleeTool then
                        for _, t in ipairs(Plr.Backpack:GetChildren()) do
                            if t:IsA("Tool") and t.ToolTip == "Melee" then meleeTool = t; break end
                        end
                    end

                    if not meleeTool then 
                        WindUI:Notify({Title="خطا", Content="هیچ میلی در کیف یا دست شما نیست!", Duration=5})
                        State.AutoDragonTalon = false; return 
                    end

                    local lowerName = string.lower(meleeTool.Name)
                    if not (string.find(lowerName, "dragon breath") or string.find(lowerName, "dragonbreath")) then
                        WindUI:Notify({Title="خطا", Content="میلی فعلی شما Dragon Breath نیست!", Duration=5})
                        State.AutoDragonTalon = false; return 
                    end

                    local masteryVal = meleeTool:FindFirstChild("Level")
                    local mastery = masteryVal and masteryVal.Value or 0
                    if mastery < 400 then
                        WindUI:Notify({Title="خطا", Content="مستری Dragon Breath شما " .. tostring(mastery) .. " است (باید بالای 400 باشد)!", Duration=5})
                        State.AutoDragonTalon = false; return 
                    end

                    -- اگر تمام شروط رعایت شد:
                    State.AutoDragonTalon = true
                    WindUI:Notify({Title="دراگون تالون", Content="پیش‌نیازها تایید شد! شروع خودکار فارم استخوان...", Duration=5})
                    
                    -- روشن کردن اتوماتیک فارم اسکلتون (از فایل Main)
                    if Deps.StartBoneFarm then Deps.StartBoneFarm() end
                else
                    State.AutoDragonTalon = false
                end
            end
        })

        -- لوپ پس‌زمینه برای دراگون تالون
        task.spawn(function()
            local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
            while task.wait(1) do
                if State.AutoDragonTalon then
                    local hasFireEssence = Plr.Backpack:FindFirstChild("Fire Essence") or (Plr.Character and Plr.Character:FindFirstChild("Fire Essence"))

                    if hasFireEssence then
                        -- وقتی آیتم رو گرفت، متوقف میکنه
                        State.AutoDragonTalon = false
                        if TurnOffAll then TurnOffAll() end 
                        
                        WindUI:Notify({Title="دراگون تالون", Content="Fire Essence بدست آمد! حرکت به سمت NPC...", Duration=5})
                        
                        local targetPos = CFrame.new(5661.079, 1207.626, 866.298)
                        local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                        if root then
                            if State.ActiveTween then State.ActiveTween:Cancel() end
                            State.ActiveTween = TweenService:Create(root, TweenInfo.new(math.max((root.Position - targetPos.Position).Magnitude/350, 0.1), Enum.EasingStyle.Linear), {CFrame = targetPos})
                            State.ActiveTween:Play()
                            State.ActiveTween.Completed:Wait()

                            task.wait(1)
                            CommF:InvokeServer("BuyDragonTalon")
                            WindUI:Notify({Title="موفقیت", Content="شمشیر/میلی Dragon Talon با موفقیت خریداری شد!", Duration=10})
                        end
                    else
                        -- خرید رندوم سورپرایز با استخوان ها
                        pcall(function()
                            local bonesData = CommF:InvokeServer("Bones", "Check")
                            local currentBones = tonumber(bonesData) or 0
                            if currentBones >= 50 then
                                CommF:InvokeServer("Bones", "Buy", 1, 1)
                            end
                        end)
                    end
                end
            end
        end)
    end

    -- ========================================================
    -- سیستم استخوان و سول ریپر
    -- ========================================================
    if Sea == 3 and BoneSec then
        BoneSec:Toggle({Title = "اتو خرید استخوان", Desc = "چک میکند و اگر بالای ۱۰۰ استخوان داشتید اتوماتیک خرید میکند", Value = false, Callback = function(s) State.AutoBuyBones = s end})
        BoneSec:Toggle({Title = "اتو اسپان و کشتن Soul Reaper (با آیتم)", Desc = "اگه Hallow Essence گرفتید، فارم را متوقف، باس را اسپان و میکشد", Value = false, Callback = function(s) State.AutoSpawnSoulReaper = s end})
        BoneSec:Toggle({Title = "اتو کشتن Soul Reaper (با نوتیفیکیشن)", Desc = "اگه نوتیفیکیشن اسپان باس آمد، میره میکشتش و برمیگرده", Value = false, Callback = function(s) State.AutoKillReaperNotif = s end})

        task.spawn(function()
            local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
            while task.wait(2) do
                if State.AutoBuyBones and State.SoulReaperPhase == "Idle" and not State.IsDoingPriorityTask and not State.AutoDragonTalon then
                    pcall(function()
                        local bonesData = CommF:InvokeServer("Bones", "Check")
                        local currentBones = tonumber(bonesData) or 0
                        if currentBones >= 100 then
                            local timesToBuy = math.floor(currentBones / 100)
                            for i = 1, timesToBuy do
                                if not State.AutoBuyBones or State.IsDoingPriorityTask then break end
                                CommF:InvokeServer("Bones", "Buy", 1, 1)
                                task.wait(1.5)
                            end
                        end
                    end)
                end
            end
        end)

        task.spawn(function()
            local Notifications = Plr:WaitForChild("PlayerGui"):WaitForChild("Notifications", 10)
            if Notifications then
                Notifications.ChildAdded:Connect(function(child)
                    if not State.AutoKillReaperNotif then return end
                    task.wait(0.1)
                    local txt = ""
                    if child:IsA("TextLabel") then txt = child.Text else for _, desc in pairs(child:GetDescendants()) do if desc:IsA("TextLabel") then txt = desc.Text; break end end end
                    
                    if string.find(txt, "An unknown being has entered this world") then
                        if not State.IsDoingPriorityTask then
                            State.IsDoingPriorityTask = true
                            PauseFarms()
                            if SetFarmMode then SetFarmMode("SoulReaper") end
                            State.SoulReaperPhase = "Attacking"
                            WindUI:Notify({Title="Soul Reaper", Content="سول ریپر اسپان شد! توقف فارم و حرکت...", Duration=5})
                        end
                    end
                end)
            end
        end)

        task.spawn(function()
            while task.wait(0.1) do
                if not State.AutoSpawnSoulReaper and not State.AutoKillReaperNotif then
                    if State.SoulReaperPhase ~= "Idle" then
                        State.SoulReaperPhase = "Idle"
                        if State.IsDoingPriorityTask then State.IsDoingPriorityTask = false; ResumeFarms() end
                    end
                    continue
                end

                local hasEssence = Plr.Backpack:FindFirstChild("Hallow Essence") or (Plr.Character and Plr.Character:FindFirstChild("Hallow Essence"))

                if State.AutoSpawnSoulReaper and State.SoulReaperPhase == "Idle" and hasEssence then
                    if not State.IsDoingPriorityTask then
                        State.IsDoingPriorityTask = true
                        PauseFarms()
                        if SetFarmMode then SetFarmMode("SoulReaper") end
                        State.SoulReaperPhase = "Spawning"
                        WindUI:Notify({Title="Soul Reaper", Content="آیتم Hallow Essence پیدا شد! حرکت به سمت محراب...", Duration=5})
                    end
                end

                if State.SoulReaperPhase == "Spawning" then
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - ReaperAltarPos.Position).Magnitude
                        if dist > 15 then
                            if State.ActiveTween then State.ActiveTween:Cancel() end
                            State.ActiveTween = TweenService:Create(root, TweenInfo.new(math.max(dist/(Settings.FlightSpeed or 350), 0.05), Enum.EasingStyle.Linear), {CFrame = ReaperAltarPos})
                            State.ActiveTween:Play()
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                            root.CFrame = ReaperAltarPos
                            local ess = Plr.Backpack:FindFirstChild("Hallow Essence")
                            if ess and Plr.Character:FindFirstChild("Humanoid") then Plr.Character.Humanoid:EquipTool(ess) end
                            task.wait(2) 
                            State.SoulReaperPhase = "Attacking"
                        end
                    end
                    
                elseif State.SoulReaperPhase == "Attacking" then
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if not root then continue end

                    local reaper = nil
                    if Workspace:FindFirstChild("Enemies") then
                        for _, v in pairs(Workspace.Enemies:GetChildren()) do
                            if string.find(v.Name, "Soul Reaper") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then reaper = v; break end
                        end
                    end
                    
                    if reaper then
                        State.SoulReaperWaitTimer = nil 
                        PrepareEnemyForBoss(reaper)
                        
                        local ep = reaper.HumanoidRootPart.Position
                        local d = (root.Position - ep); d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude < 0.1 then d = Vector3.new(1,0,0) end; d = d.Unit
                        local dest = CFrame.lookAt(ep + d * (Settings.AttackDistance or 40) + Vector3.new(0, (Settings.AttackHeight or 40), 0), ep)
                        
                        if (root.Position - dest.Position).Magnitude > 10 then 
                            if State.ActiveTween then State.ActiveTween:Cancel() end
                            State.ActiveTween = TweenService:Create(root, TweenInfo.new(math.max((root.Position - dest.Position).Magnitude/(Settings.FlightSpeed or 350), 0.05), Enum.EasingStyle.Linear), {CFrame = dest})
                            State.ActiveTween:Play()
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                            root.CFrame = dest
                            EquipWeaponGeneral()
                            if reaper:FindFirstChild("Head") then Workspace.CurrentCamera.CFrame = CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, reaper.Head.Position) end
                            
                            task.spawn(function()
                                local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
                                for i=1,3 do
                                    VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1); task.wait(Settings.HoldTime or 0.05); VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)
                                    if RegisterAttack then RegisterAttack:FireServer(math.floor((0.5 + math.random() * 0.5) * 10000) / 10000) end
                                end
                            end)
                        end
                    else
                        if not State.SoulReaperWaitTimer then State.SoulReaperWaitTimer = tick() end
                        
                        if (root.Position - ReaperArenaPos.Position).Magnitude > 15 then
                            if State.ActiveTween then State.ActiveTween:Cancel() end
                            State.ActiveTween = TweenService:Create(root, TweenInfo.new(math.max((root.Position - ReaperArenaPos.Position).Magnitude/(Settings.FlightSpeed or 350), 0.05), Enum.EasingStyle.Linear), {CFrame = ReaperArenaPos})
                            State.ActiveTween:Play()
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                        end

                        if tick() - State.SoulReaperWaitTimer > 15 then
                            State.SoulReaperPhase = "Idle"
                            State.SoulReaperWaitTimer = nil
                            if State.IsDoingPriorityTask then
                                State.IsDoingPriorityTask = false
                                ResumeFarms()
                                WindUI:Notify({Title="Soul Reaper", Content="عملیات پایان یافت! بازگشت به فارم...", Duration=5})
                            end
                        end
                    end
                end
            end
        end)
    end

    -- ========================================================
    -- هسته Noclip موقع اتک
    -- ========================================================
    RunService.Heartbeat:Connect(function()
        pcall(function()
            if (State.DarkbeardState == "Attacking" or State.SoulReaperPhase == "Attacking") and Plr.Character then
                for _, p in pairs(Plr.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
                if Plr.Character:FindFirstChild("HumanoidRootPart") then Plr.Character.HumanoidRootPart.Velocity = Vector3.zero end
            end
        end)
    end)

    -- بقیه کدهای دارک بیرد و چست ...
    if Sea == 2 or Sea == 3 then
        task.spawn(function()
            while task.wait(1) do
                if State.StopChestOnSpecialItem then
                    local shouldStop, itemName = false, ""
                    if Sea == 2 then
                        itemName = "Fist of Darkness"
                        if Plr.Backpack:FindFirstChild(itemName) or (Plr.Character and Plr.Character:FindFirstChild(itemName)) then shouldStop = true end
                    elseif Sea == 3 then
                        itemName = "God's Chalice"
                        if Plr.Backpack:FindFirstChild(itemName) or (Plr.Character and Plr.Character:FindFirstChild(itemName)) then shouldStop = true end
                    end
                    
                    if shouldStop then
                        State.StopChestOnSpecialItem = false 
                        PauseFarms()
                        if SetFarmMode then SetFarmMode("None") end
                        WindUI:Notify({Title="توقف خودکار چست", Content="آیتم " .. itemName .. " گرفته شد! اسکریپت متوقف شد.", Duration=5})
                    end
                end
            end
        end)
    end

    if Sea == 2 then
        task.spawn(function()
            local Notifications = Plr:WaitForChild("PlayerGui"):WaitForChild("Notifications", 10)
            if Notifications then
                Notifications.ChildAdded:Connect(function(child)
                    if not State.AutoKillDarkbeardEventEnabled then return end
                    local textLabel = child:WaitForChild("TextLabel", 2) or child:FindFirstChildOfClass("TextLabel")
                    if not textLabel then for _, desc in pairs(child:GetDescendants()) do if desc:IsA("TextLabel") then textLabel = desc; break end end end

                    if textLabel then
                        local timeout = tick() + 3
                        while tick() < timeout do
                            local txt = textLabel.Text
                            if txt ~= "" and txt ~= "Label" then
                                if string.find(txt, "The power of darkness has been unleashed") then
                                    if not State.IsDoingPriorityTask then
                                        State.IsDoingPriorityTask = true
                                        PauseFarms()
                                        if SetFarmMode then SetFarmMode("Darkbeard") end
                                        State.DarkbeardState = "Attacking"
                                        WindUI:Notify({Title="Darkbeard Event", Content="دارک بیرد اسپان شد! شروع اتک دادن...", Duration=5})
                                    end
                                end
                                break
                            end
                            task.wait(0.05)
                        end
                    end
                end)
            end
        end)

        task.spawn(function()
            while task.wait(0.1) do
                if not State.AutoDarkbeardEnabled and not State.AutoKillDarkbeardEventEnabled then
                    if State.DarkbeardState ~= "Idle" then
                        State.DarkbeardState = "Idle"; State.DarkbeardTarget = nil
                        if State.IsDoingPriorityTask then State.IsDoingPriorityTask = false; ResumeFarms() end
                    end
                    continue
                end

                local hasFist = Plr.Backpack:FindFirstChild("Fist of Darkness") or (Plr.Character and Plr.Character:FindFirstChild("Fist of Darkness"))

                if State.AutoDarkbeardEnabled and State.DarkbeardState == "Idle" and hasFist then
                    if not State.IsDoingPriorityTask then
                        State.IsDoingPriorityTask = true
                        PauseFarms()
                        if SetFarmMode then SetFarmMode("Darkbeard") end
                        State.DarkbeardState = "Spawning"
                        WindUI:Notify({Title="Darkbeard", Content="Fist of Darkness پیدا شد! حرکت به سمت محل اسپان...", Duration=5})
                    end
                end

                if State.DarkbeardState == "Spawning" then
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - DarkbeardSpawnPos.Position).Magnitude
                        if dist > 15 then
                            if State.ActiveTween then State.ActiveTween:Cancel() end
                            State.ActiveTween = TweenService:Create(root, TweenInfo.new(math.max(dist/(Settings.FlightSpeed or 350), 0.05), Enum.EasingStyle.Linear), {CFrame=DarkbeardSpawnPos})
                            State.ActiveTween:Play()
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                            root.CFrame = DarkbeardSpawnPos
                            local fistTool = Plr.Backpack:FindFirstChild("Fist of Darkness")
                            if fistTool and Plr.Character:FindFirstChild("Humanoid") then Plr.Character.Humanoid:EquipTool(fistTool) end
                            task.wait(3); State.DarkbeardState = "Attacking"
                        end
                    end
                    
                elseif State.DarkbeardState == "Attacking" then
                    local root = Plr.Character and Plr.Character:FindFirstChild("HumanoidRootPart")
                    if not root then continue end

                    local darkbeard = nil
                    if Workspace:FindFirstChild("Enemies") then
                        for _, v in pairs(Workspace.Enemies:GetChildren()) do
                            if string.find(v.Name, "Darkbeard") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then darkbeard = v; break end
                        end
                    end
                    
                    if darkbeard then
                        State.DarkbeardWaitTimer = nil; State.DarkbeardTarget = darkbeard
                        PrepareEnemyForBoss(darkbeard)
                        
                        local EP = darkbeard.HumanoidRootPart.Position
                        local d = (root.Position - EP); d = Vector3.new(d.X, 0, d.Z)
                        if d.Magnitude < 0.1 then d = Vector3.new(1,0,0) end; d = d.Unit
                        local dest = CFrame.lookAt(EP + d * (Settings.AttackDistance or 40) + Vector3.new(0, (Settings.AttackHeight or 40), 0), EP)
                        
                        local dist = (root.Position - dest.Position).Magnitude
                        if dist < 10 then 
                            root.CFrame = dest
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                            EquipWeaponGeneral()
                            if darkbeard:FindFirstChild("Head") then Workspace.CurrentCamera.CFrame = CFrame.lookAt(Workspace.CurrentCamera.CFrame.Position, darkbeard.Head.Position) end
                            
                            task.spawn(function()
                                local CX, CY = Workspace.CurrentCamera.ViewportSize.X/2, Workspace.CurrentCamera.ViewportSize.Y/2
                                for i=1,3 do
                                    VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, true, game, 1); task.wait(Settings.HoldTime or 0.05); VirtualInputManager:SendMouseButtonEvent(CX, CY, 0, false, game, 1)
                                    if RegisterAttack then RegisterAttack:FireServer(math.floor((0.5 + math.random() * 0.5) * 10000) / 10000) end
                                end
                            end)
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel() end
                            State.ActiveTween = TweenService:Create(root, TweenInfo.new(math.max(dist/(Settings.FlightSpeed or 350), 0.05), Enum.EasingStyle.Linear), {CFrame=dest})
                            State.ActiveTween:Play()
                        end
                    else
                        State.DarkbeardTarget = nil
                        if not State.DarkbeardWaitTimer then State.DarkbeardWaitTimer = tick() end
                        
                        local dist = (root.Position - DarkbeardSpawnPos.Position).Magnitude
                        if dist > 15 then
                            if State.ActiveTween then State.ActiveTween:Cancel() end
                            State.ActiveTween = TweenService:Create(root, TweenInfo.new(math.max(dist/(Settings.FlightSpeed or 350), 0.05), Enum.EasingStyle.Linear), {CFrame=DarkbeardSpawnPos})
                            State.ActiveTween:Play()
                        else
                            if State.ActiveTween then State.ActiveTween:Cancel(); State.ActiveTween = nil end
                        end

                        if tick() - State.DarkbeardWaitTimer > 15 then
                            State.DarkbeardState = "Idle"; State.DarkbeardWaitTimer = nil
                            if State.IsDoingPriorityTask then State.IsDoingPriorityTask = false; ResumeFarms(); WindUI:Notify({Title="Darkbeard", Content="عملیات پایان یافت! بازگشت...", Duration=5}) end
                        end
                    end
                end
            end
        end)
    end

    if Sea == 2 and BossTab then
        local DarkbeardSec = BossTab:Section({Title = " اتو دارک بیرد (Darkbeard)", Box = true, BoxBorder = true, Opened = true})
        DarkbeardSec:Toggle({Title = "اتو اسپان و کشتن Darkbeard", Value = false, Callback = function(s) State.AutoDarkbeardEnabled = s end})
        DarkbeardSec:Toggle({Title = "کشتن دارک برید وقتی اسپان شد", Value = false, Callback = function(s) State.AutoKillDarkbeardEventEnabled = s end})
    end
end

return ExtraModule1
